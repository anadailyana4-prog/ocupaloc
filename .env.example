#   -H "Authorization: Bearer YOUR_INIT_SECRET_TOKEN" \
#   -H "Content-Type: application/json" \
#   -d '{"email": "your@email.com"}'
OWNER_INIT_SECRET=your-secure-init-token-here-change-in-production
